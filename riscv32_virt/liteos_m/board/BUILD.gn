import("//kernel/liteos_m/liteos.gni")

kernel_module("bsp_config") {
  asmflags = board_asmflags
  sources = [
    "driver/plic.c",
    "driver/uart.c",
    "main.c",
    "riscv_hal.c",
  ]
  if (!defined(LOSCFG_TEST)) {
    # kernel's testsuites not enabled, use ower's
    sources += [ "test/test_demo.c" ]
  }
  include_dirs = [
    "driver",
    "hardware",
    "hardware/adapter",
    "//third_party/bounds_checking_function/include",
  ]

  deps = [
    "libc",
  ]
}

config("public") {
  include_dirs = [
    ".",
    "include",
    "include/asm",
    "driver",
  ]

  ldflags = [
    "-Wl,-mcmodel=medany",
    "-Wl,-melf32lriscv",
    "-nostartfiles",
    "-Wl,-T" + rebase_path("liteos.ld"),
    "-nostdlib",
  ]

  # config force_link_libs from vendor/ohemu/qemu_riscv32_mini_system_demo/config.json
  if (defined(force_link_libs) && force_link_libs != []) {
    ldflags += [ "-L./libs" ]
    ldflags += [ "-Wl,--whole-archive" ]
    foreach(force_link_lib, force_link_libs) {
      ldflags += [ "-l${force_link_lib}" ]
    }
    ldflags += [ "-Wl,--no-whole-archive" ]
  }

  libs = [
    "nosys",
    "gcc",
    "stdc++",
  ]

  if (defined(LOSCFG_LIBC_NEWLIB)) {
    ldflags -= [ "-nostdlib" ]

    libs -= [ "nosys" ]
    libs += [
      "c",
      "m",
    ]

    cflags_c = [
      "-U__INT32_TYPE__",
      "-D__INT32_TYPE__=int",
      "-DLWIP_NO_CTYPE_H=1",
    ]
  }
}
