import("//build/ohos.gni")
import("//device/qemu/common/virt_full/device.gni")

root_path = "../../../../../../.."

group("virt_jpeg_codec_model") {
  deps = [ ":libjpeg_vdi_impl" ]
}

ohos_shared_library("libjpeg_vdi_impl") {
  include_dirs = [
    "include",
    "${root_path}/drivers/peripheral/codec/image/vdi",
    "${root_path}/drivers/peripheral/codec/utils/include",
    "${root_path}/drivers/peripheral/display/buffer/hdi_service/include",
    "${root_path}/drivers/peripheral/display/interfaces/include",
    "${root_path}/drivers/hdf_core/interfaces/inner_api/utils",
    # jpeglib.h/jerror.h/jmorecfg.h are generated by the libjpeg-turbo
    # extraction action into its gen tree, not tracked in the source root
    "${root_gen_dir}/third_party/libjpeg-turbo/libjpeg-turbo-3.1.0/src",
    "${root_gen_dir}",
    "${root_gen_dir}/drivers/interface/display/buffer",
  ]

  sources = [
    "src/virt_jpeg_decoder.cpp",
    "src/virt_jpeg_impl.cpp",
    "src/virt_jpeg_interface.cpp",
  ]

  output_name = "libjpeg_vdi_impl"

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "drivers_interface_display:display_buffer_idl_headers",
    "drivers_interface_display:display_buffer_idl_headers_1.2",
    "graphic_surface:buffer_handle",
    "hilog:libhilog",
  ]

  # generate the jpeglib headers before compiling; the sources only dlopen
  # libturbojpeg at runtime, so this is a build-order dependency only
  deps = [ "${root_path}/third_party/libjpeg-turbo:libjpeg_action" ]

  defines += [ "LOG_TAG_IMAGE" ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
}
