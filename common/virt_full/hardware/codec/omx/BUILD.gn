import("//build/ohos.gni")
import("//device/qemu/common/virt_full/device.gni")

root_path = "../../../../../../.."

group("virt_omx_core_model") {
  deps = [ ":libOMX_Core" ]
}

ohos_shared_library("libOMX_Core") {
  include_dirs = [
    "include",
    "${root_path}/drivers/peripheral/display/interfaces/include",
  ]

  sources = [
    "src/virt_omx_component.cpp",
    "src/virt_omx_core.cpp",
  ]

  output_name = "OMX_Core"

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "openmax:libopenmax_static",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
}
