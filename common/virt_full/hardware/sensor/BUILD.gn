import("//build/ohos.gni")
import("//device/qemu/common/virt_full/device.gni")

root_path = "../../../../../.."

group("sensor_sim_model") {
  deps = [ ":libhdi_product_sensor_impl" ]
}

ohos_shared_library("libhdi_product_sensor_impl") {
  sources = [ "sensor_sim_vdi.cpp" ]

  include_dirs = [
    "${root_path}/drivers/peripheral/sensor/interfaces/include",
    "${root_path}/drivers/peripheral/sensor/interfaces/v1_0",
    "${root_path}/drivers/peripheral/sensor/utils/include",
    "${root_path}/drivers/peripheral/sensor/hal/include",
    "${root_path}/drivers/hdf_core/interfaces/inner_api/host/uhdf",
    "${root_gen_dir}",
    "${root_gen_dir}/drivers/interface",
    "${root_gen_dir}/drivers/interface/sensor",
  ]

  output_name = "libhdi_product_sensor_impl"

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "hdf_core:libhdf_utils",
    "hilog:libhilog",
    "ipc:ipc_single",
  ]

  install_enable = true
  install_images = [ chipset_base_dir ]
  subsystem_name = virt_subsystem_name
  part_name = virt_part_name
}
